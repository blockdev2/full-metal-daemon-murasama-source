[
 {
  "offset": 213,
  "en": "md02/0380010e287",
  "pt": ""
 },
 {
  "offset": 237,
  "en": "\"Did you see her?\"",
  "pt": ""
 },
 {
  "offset": 263,
  "en": "md02/0380020e288",
  "pt": ""
 },
 {
  "offset": 287,
  "en": "\"Yeah. You were right. That's Ashikaga Chachamaru!\"",
  "pt": ""
 },
 {
  "offset": 346,
  "en": "md02/0380030e287",
  "pt": ""
 },
 {
  "offset": 370,
  "en": "\"She only has two guards. A man and a woman.\"",
  "pt": ""
 },
 {
  "offset": 423,
  "en": "md02/0380040e289",
  "pt": ""
 },
 {
  "offset": 447,
  "en": "\"...Do we go for it?\"",
  "pt": ""
 },
 {
  "offset": 476,
  "en": "md02/0380050e288",
  "pt": ""
 },
 {
  "offset": 500,
  "en": "\"Damn right we do! We're not letting this chance go to waste!\"",
  "pt": ""
 },
 {
  "offset": 570,
  "en": "md02/0380060e289",
  "pt": ""
 },
 {
  "offset": 594,
  "en": "\"But we didn't come prepared. We need time to get ready.\"",
  "pt": ""
 },
 {
  "offset": 659,
  "en": "md02/0380070e288",
  "pt": ""
 },
 {
  "offset": 683,
  "en": "\"They're unarmed. Knives are all we need.\"",
  "pt": ""
 },
 {
  "offset": 733,
  "en": "md02/0380080e287",
  "pt": ""
 },
 {
  "offset": 757,
  "en": "\"Don't be stupid! They're Rokuhara.\"",
  "pt": ""
 },
 {
  "offset": 801,
  "en": "md02/0380090e289",
  "pt": ""
 },
 {
  "offset": 825,
  "en": "\"Then what do you suggest?\"",
  "pt": ""
 },
 {
  "offset": 860,
  "en": "md02/0380100e287",
  "pt": ""
 },
 {
  "offset": 884,
  "en": "\"We'll wait for Yazawa to get back.\"",
  "pt": ""
 },
 {
  "offset": 928,
  "en": "md02/0380110e289",
  "pt": ""
 },
 {
  "offset": 952,
  "en": "\"Yazawa? Is he getting the guns?\"",
  "pt": ""
 },
 {
  "offset": 993,
  "en": "md02/0380120e287",
  "pt": ""
 },
 {
  "offset": 1017,
  "en": "\"Something even better. Don't worry. He'll be back soon.\"",
  "pt": ""
 }
]
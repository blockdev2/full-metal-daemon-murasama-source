[
 {
  "offset": 213,
  "en": "md02/0380010e287",
  "pt": "md02/0380010e287"
 },
 {
  "offset": 237,
  "en": "\"Did you see her?\"",
  "pt": "\"Você a viu?\""
 },
 {
  "offset": 263,
  "en": "md02/0380020e288",
  "pt": "md02/0380020e288"
 },
 {
  "offset": 287,
  "en": "\"Yeah. You were right. That's Ashikaga Chachamaru!\"",
  "pt": "\"Vi. Você estava certo. É a Ashikaga Chachamaru!\""
 },
 {
  "offset": 346,
  "en": "md02/0380030e287",
  "pt": "md02/0380030e287"
 },
 {
  "offset": 370,
  "en": "\"She only has two guards. A man and a woman.\"",
  "pt": "\"Ela só tem dois guardas. Um homem e uma mulher.\""
 },
 {
  "offset": 423,
  "en": "md02/0380040e289",
  "pt": "md02/0380040e289"
 },
 {
  "offset": 447,
  "en": "\"...Do we go for it?\"",
  "pt": "\"...Vamos em frente?\""
 },
 {
  "offset": 476,
  "en": "md02/0380050e288",
  "pt": "md02/0380050e288"
 },
 {
  "offset": 500,
  "en": "\"Damn right we do! We're not letting this chance go to waste!\"",
  "pt": "\"Claro que vamos! Não vamos desperdiçar essa chance!\""
 },
 {
  "offset": 570,
  "en": "md02/0380060e289",
  "pt": "md02/0380060e289"
 },
 {
  "offset": 594,
  "en": "\"But we didn't come prepared. We need time to get ready.\"",
  "pt": "\"Mas não viemos preparados. Precisamos de tempo para nos preparar.\""
 },
 {
  "offset": 659,
  "en": "md02/0380070e288",
  "pt": "md02/0380070e288"
 },
 {
  "offset": 683,
  "en": "\"They're unarmed. Knives are all we need.\"",
  "pt": "\"Eles estão desarmados. Facas é tudo de que precisamos.\""
 },
 {
  "offset": 733,
  "en": "md02/0380080e287",
  "pt": "md02/0380080e287"
 },
 {
  "offset": 757,
  "en": "\"Don't be stupid! They're Rokuhara.\"",
  "pt": "\"Não seja idiota! Eles são Rokuhara.\""
 },
 {
  "offset": 801,
  "en": "md02/0380090e289",
  "pt": "md02/0380090e289"
 },
 {
  "offset": 825,
  "en": "\"Then what do you suggest?\"",
  "pt": "\"Então o que você sugere?\""
 },
 {
  "offset": 860,
  "en": "md02/0380100e287",
  "pt": "md02/0380100e287"
 },
 {
  "offset": 884,
  "en": "\"We'll wait for Yazawa to get back.\"",
  "pt": "\"Vamos esperar o Yazawa voltar.\""
 },
 {
  "offset": 928,
  "en": "md02/0380110e289",
  "pt": "md02/0380110e289"
 },
 {
  "offset": 952,
  "en": "\"Yazawa? Is he getting the guns?\"",
  "pt": "\"Yazawa? Ele está conseguindo as armas?\""
 },
 {
  "offset": 993,
  "en": "md02/0380120e287",
  "pt": "md02/0380120e287"
 },
 {
  "offset": 1017,
  "en": "\"Something even better. Don't worry. He'll be back soon.\"",
  "pt": "\"Algo ainda melhor. Não se preocupe. Ele volta logo.\""
 }
]